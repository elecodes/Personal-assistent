# Internal integration token, created at https://www.notion.so/my-integrations
NOTION_TOKEN=secret_replace_with_your_integration_token

# Id of the Notion data source that receives the task pages.
# Accepts the 32-character id or the dashed UUID; it is not the page url.
NOTION_DATA_SOURCE_ID=00000000000000000000000000000000

# Absolute path to your local Obsidian Vault directory
OBSIDIAN_VAULT_PATH=/Users/tu_usuario/Obsidian/MiVault

# Subfolder inside Obsidian Vault where notes should be saved (e.g., Ideas, Tareas, Ingest)
OBSIDIAN_FOLDER=Ideas
